<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BetterLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/app_menu_foreground</item>
        <item name="colorOnPrimary">@color/app_menu_surface</item>
        <item name="colorSecondary">@color/app_menu_foreground</item>
        <item name="colorSurface">@color/app_menu_surface</item>
        <item name="colorOnSurface">@color/app_menu_foreground</item>
        <item name="colorOnSurfaceVariant">@color/app_menu_foreground</item>
        <item name="colorOutline">@color/app_menu_foreground</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@color/app_menu_foreground</item>
        <item name="android:windowSplashScreenBackground">@color/app_menu_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="Theme.BetterLauncher.AppMenu" parent="Theme.BetterLauncher">
        <item name="android:windowAnimationStyle">@style/Animation.BetterLauncher.AppMenu</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:navigationBarColor">@color/app_menu_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Animation.BetterLauncher.AppMenu" parent="">
        <item name="android:windowEnterAnimation">@anim/app_menu_enter</item>
        <item name="android:windowExitAnimation">@anim/app_menu_exit</item>
    </style>
</resources>
